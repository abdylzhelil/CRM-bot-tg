# Токен бота-менеджера от @BotFather
BOT_TOKEN=
# Telegram ID владельца (через запятую, если несколько)
OWNER_IDS=
# SQLite на старте; для PostgreSQL: postgresql+asyncpg://user:pass@db:5432/crm
DATABASE_URL=sqlite+aiosqlite:///data/crm.db
# Часовой пояс для режима тишины и отчётов
TZ_NAME=Europe/Moscow
# Telegram API (my.telegram.org) — значения по умолчанию для новых разведчиков
TG_API_ID=
TG_API_HASH=

# Связь с ботом модерации (tg-group-bot): общий секрет, тот же, что CRM_FEED_TOKEN у него.
# Сгенерировать: openssl rand -hex 16. Пусто — приём выключен.
FEED_TOKEN=

# Онлайн-оплата тарифов: @BotFather -> ваш бот -> Payments -> выберите провайдера (например, ЮKassa) -> скопируйте токен.
# Цены пакетов задаются в боте: ⚙️ Настройки (0 — пакет не продаётся). Пусто — оплата выключена.
PAYMENT_PROVIDER_TOKEN=
PAYMENT_CURRENCY=RUB
# Публичный канал со статистикой (@имя_канала). Добавьте бота в канал администратором. Пусто — выключено.
STATS_CHANNEL=

# Возврат денег кнопкой в боте (необязательно): кабинет ЮKassa -> Интеграция -> Ключи API. Без них тариф снимается, а деньги
# возвращаются вручную в кабинете.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# «Сторож» сервера: адрес отметки из healthchecks.io (бот пингует раз в 5 минут; если пропал — сервис пришлёт вам сообщение). Пусто — выключено.
HEARTBEAT_URL=

# ИИ на Claude (кнопка «✨ Черновик ответа»): ключ с console.anthropic.com -> API Keys. Пусто — ИИ выключен.
ANTHROPIC_API_KEY=

# Российский ИИ (те же строки, что в .env бота модерации — можно скопировать оттуда):
# AI_PROVIDER: gigachat | yandex | local | anthropic | пусто — первый, для которого есть ключ
AI_PROVIDER=
GIGACHAT_AUTH_KEY=
# GIGACHAT_SCOPE=GIGACHAT_API_PERS
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
# YANDEX_MODEL=yandexgpt-lite/latest
# Своя модель бота модерации (Ollama): LOCAL_AI=1, LOCAL_AI_URL=http://ollama:11434
